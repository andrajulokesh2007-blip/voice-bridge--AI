# VoiceBridge AI Backend Environment Variables

# Server Port
PORT=5000

# MongoDB Connection String (Atlas or Local MongoDB)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/voicebridge?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/voicebridge
MONGODB_URI=mongodb://127.0.0.1:27017/voicebridge

# JWT Authentication Secret Key
JWT_SECRET=replace_with_a_long_random_jwt_secret_key_minimum_32_chars

# Google Gemini API Key
# Obtain free from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# Environment (development / production)
NODE_ENV=development
